{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "icon": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "platform",
    "link"
  ]
}